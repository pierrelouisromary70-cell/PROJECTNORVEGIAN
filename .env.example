# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Two recurring prices in Stripe: monthly (15 €/mo) and annual (120 €/yr).
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
# Legacy fallback used if STRIPE_PRICE_ID_MONTHLY is not set.
STRIPE_PRICE_ID=

# Strava (OAuth + manual activity import)
# Create an app at https://www.strava.com/settings/api
# Authorization callback domain must match NEXT_PUBLIC_APP_URL host.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Secret used to sign the OAuth `state` parameter (HMAC). If unset we fall
# back to SUPABASE_SERVICE_ROLE_KEY, which works but is less hygienic.
STRAVA_OAUTH_STATE_SECRET=
# Verify token for the webhook subscription. Strava sends this in the
# initial GET handshake on /api/strava/webhook. Pick any random string,
# then use it when creating the subscription (see README).
STRAVA_VERIFY_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
